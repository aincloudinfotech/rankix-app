# Rankix.ai - Environment variables (example)
# Copy to .env.local and fill in. Never commit .env.local.
# In Vercel, set these in Project Settings > Environment Variables.

# === Wave 1: not used yet (mock data) ===
# === Wave 2+: real backend ===

# Supabase (public — safe in client code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (server-only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (for AI features in Wave 2+)
ANTHROPIC_API_KEY=your-anthropic-api-key

# PostHog analytics (set in Phase 0)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
